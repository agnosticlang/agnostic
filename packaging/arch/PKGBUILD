# Maintainer: AnmiTaliDev <anmitalidev@nuros.org>
pkgname=agnostic
pkgver=${AGNOSTIC_VERSION:-0.0.0}
pkgrel=1
pkgdesc="The Agnostic programming language compiler"
arch=('x86_64')
url="https://github.com/agnosticlang/agnostic"
license=('Apache-2.0')
depends=('llvm-libs')
makedepends=('cmake' 'llvm' 'clang')
source=()

build() {
    cmake -S "$startdir/../.." -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DAGNOSTIC_VERSION="$pkgver"
    cmake --build "$srcdir/build" -j"$(nproc)"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build" --prefix /usr
}

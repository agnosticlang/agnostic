pkgname=agnostic
pkgver=${AGNOSTIC_VERSION:-0.0.0}
pkgrel=1
pkgdesc="The Agnostic programming language compiler"
arch=('x86_64')
url="https://github.com/agnosticlang/agnostic"
license=('GPL-3.0-or-later' 'Apache-2.0')
depends=('llvm-libs' 'libgccjit')
makedepends=('cmake' 'llvm' 'clang' 'libgccjit')
options=('staticlibs' '!strip')
source=()

build() {
    "$startdir/../../scripts/build.sh" "$startdir/../.." "$srcdir/build" \
        -DAGNOSTIC_VERSION="$pkgver"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build" --prefix /usr
}

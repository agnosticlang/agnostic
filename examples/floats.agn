package main

import "stdio"

func circleArea(radius float) float {
    var pi float = 3.14159
    return pi * radius * radius
}

func average(a float, b float, c float) float {
    return (a + b + c) / 3.0
}

func main() {
    var r float = 2.0
    stdio.PrintlnFloat(circleArea(r))

    var x float = 1.5
    var y float = 2.5
    stdio.PrintlnFloat(x + y)
    stdio.PrintlnFloat(x - y)
    stdio.PrintlnFloat(x * y)
    stdio.PrintlnFloat(x / y)
    stdio.PrintlnFloat(-x)

    if x < y {
        stdio.PrintlnStr("x < y")
    }

    stdio.PrintlnFloat(average(1.0, 2.0, 3.0))

    var n int = 4
    stdio.PrintlnFloat(x + n as float)
}

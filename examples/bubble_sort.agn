package main

import "stdio"

func main() {
    var arr [8]int
    arr[0] = 5
    arr[1] = 2
    arr[2] = 9
    arr[3] = 1
    arr[4] = 7
    arr[5] = 3
    arr[6] = 8
    arr[7] = 4

    var n int = 8
    var i int = 0
    for i < n {
        var j int = 0
        for j < n - i - 1 {
            if arr[j] > arr[j + 1] {
                var tmp int = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }

    i = 0
    for i < n {
        stdio.Println(arr[i])
        i = i + 1
    }
}

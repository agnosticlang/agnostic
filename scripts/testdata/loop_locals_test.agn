package main

import "stdio"

func main() {
    var total int = 0
    var i int = 0
    for i < 2000000 {
        var step int = i % 3
        var buf [64]i8
        buf[0] = step
        total = total + buf[0]
        i = i + 1
    }
    stdio.Println(total)
}

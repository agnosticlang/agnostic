package main

import "os"
import "string"
import "stdio"

func main() {
    stdio.PrintlnStr(string.toUpper("hello"))
    stdio.PrintlnStr(string.toLower("WORLD"))

    var idx Option<int> = string.indexOf("hello world", "world")
    stdio.PrintlnBool(idx.some)
    stdio.Println(idx.value)

    var idxMiss Option<int> = string.indexOf("hello world", "xyz")
    stdio.PrintlnBool(idxMiss.some)

    stdio.PrintlnBool(string.contains("hello world", "lo wo"))
    stdio.PrintlnBool(string.contains("hello world", "xyz"))
    stdio.PrintlnBool(string.startsWith("hello", "he"))
    stdio.PrintlnBool(string.startsWith("hello", "lo"))
    stdio.PrintlnBool(string.endsWith("hello", "lo"))
    stdio.PrintlnBool(string.endsWith("hello", "he"))

    var ch Option<int> = string.charAt("hello", 1)
    stdio.PrintlnBool(ch.some)
    stdio.Println(ch.value)

    stdio.PrintlnStr(string.substr("hello world", 6, 5))

    var trueArgCount int = 1
    if os.ArgCount() >= trueArgCount {
        stdio.PrintlnStr("argcount_ok")
    }

    var fd Option<int> = os.OpenCreate("/tmp/agn_os_string_test.txt")
    os.WriteFd(fd.value, "roundtrip")
    os.Close(fd.value)

    var rfd Option<int> = os.OpenRead("/tmp/agn_os_string_test.txt")
    var buf [16]u8
    var n Option<int> = os.ReadFd(rfd.value, &buf, 15)
    os.Close(rfd.value)
    stdio.PrintlnBool(n.some)
    stdio.Println(n.value)
}
